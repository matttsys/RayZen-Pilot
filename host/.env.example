# RayZen Pilot configuration
# Copy this file to .env and fill in the first two values. Everything else is optional.

# Bot token from @BotFather
BOT_TOKEN=

# Your numeric Telegram user id (send /start to @userinfobot to get it)
OWNER_ID=

# AI assistant (optional). Any OpenAI-compatible API works.
# Leave AI_API_KEY empty to run without AI; all normal commands still work.
AI_BASE_URL=https://inference-api.nousresearch.com/v1
AI_API_KEY=
AI_MODEL=meituan/longcat-2.5-preview:free
AI_FALLBACK_MODELS=reflection/beam-1.0-501b-a23b:free,stepfun/step-5-preview:free,stepfun/step-3.7-flash:free

# Default timezone for new groups (each group can change it with /timezone)
TZ=Asia/Tehran

# Chat id for owner notices (startup, bot added/removed). Empty = your private chat.
LOG_CHANNEL=

# Tuning (defaults shown)
# AI_TIMEOUT_S=60
# AI_CONCURRENCY=2
# AI_USER_PER_10MIN=8
# AI_GROUP_PER_HOUR=30
# AI_GLOBAL_PER_DAY=3000
# AI_EXTRA_BODY={"temperature":0.2}
# DB_PATH_PILOT=data/pilot.db
# LOG_LEVEL=INFO
# SERVER_PORT=8080
